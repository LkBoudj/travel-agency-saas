{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "/node_modules/": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "npm install*": "ask",
      "npm run *": "allow",
      "rm -rf*": "deny",
      "grep *": "allow",
      "cat *": "allow"
    },
    "webfetch": "ask",
    "skill": {
      "api-query-pattern": "allow",
      "forms-with-zod": "allow",
      "react-router-pattern": "allow",
      "shadcn-usage": "allow",
      "theme-management": "allow",
      "zustand-store-pattern": "allow",
      "*": "allow"
    }
  }
}