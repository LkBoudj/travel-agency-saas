# Agency Dashboard environment.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the committed
# reference, so every new variable belongs here too.
#
# Only variables prefixed with VITE_ reach the browser bundle. Never put a
# secret in this file or in `.env`: everything here is compiled into the
# client and is readable by anyone who opens the app.

# --- Backend -----------------------------------------------------------------
# Origin of the NestJS API, with no trailing slash. Request paths already
# include the /v1 prefix.
VITE_API_BASE_URL=http://localhost:3000

# --- Dev server --------------------------------------------------------------
# The port `npm run dev` binds, with strictPort — startup fails loudly if it is
# taken rather than drifting to another port.
#
# IMPORTANT: this origin must appear in the backend's CORS allowlist, otherwise
# every request is blocked by the browser. The backend allows 5173 (dashboard)
# and 5174 (admin) in development by default; anything else needs CORS_ORIGINS
# set in backend/.env.
VITE_DEV_PORT=5175

# --- Misc --------------------------------------------------------------------
# Domain suffix suggested in the future agency creation guest flow.
VITE_PLATFORM_DOMAIN=example.com