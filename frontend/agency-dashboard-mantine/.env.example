# Agency Dashboard environment.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the committed
# reference, so every new variable belongs here too.
#
# Only variables prefixed with VITE_ reach the browser bundle. Never put a
# secret in this file or in `.env`: everything here is compiled into the
# client and is readable by anyone who opens the app.

# --- Backend -----------------------------------------------------------------
# Origin of the NestJS API, with no trailing slash. Request paths already
# include the /v1 prefix.
VITE_API_BASE_URL=http://localhost:3000

# --- Theme registry ----------------------------------------------------------
# Base that serves `GET <base>/themes.json` — the theme catalog for the
# Website → Themes screen. In development this is the root-relative path the
# Vite dev server proxies to theme-agency (`server.proxy['/themes']` →
# http://localhost:4321), so the browser never does a cross-origin fetch. In
# production set the deployed origin (no trailing slash). The website content
# API itself is served by VITE_API_BASE_URL (same origin, no new host).
# Dev:        VITE_THEMES_BASE_URL=/themes
# Production: VITE_THEMES_BASE_URL=https://themes.example.com
VITE_THEMES_BASE_URL=/themes

# --- Dev server --------------------------------------------------------------
# The port `npm run dev` binds, with strictPort — startup fails loudly if it is
# taken rather than drifting to another port.
#
# IMPORTANT: this origin must appear in the backend's CORS allowlist, otherwise
# every request is blocked by the browser. The backend allows 5173 (dashboard)
# and 5174 (admin) in development by default; anything else needs CORS_ORIGINS
# set in backend/.env.
VITE_DEV_PORT=5175

# --- Misc --------------------------------------------------------------------
# Domain suffix suggested in the future agency creation guest flow.
VITE_PLATFORM_DOMAIN=example.com

# --- Storefront (public website) ---------------------------------------------
# Origin of the public storefront (frontend/theme-agency, Astro). Optional: the
# dev storefront is single-tenant (it resolves ONE agency from its hostname /
# LOCALHOST_TENANT_SLUG), so this origin is the live site of that agency. Leave
# it unset in production — the public URL is then built per tenant as
# https://<slug>.<platformDomain>/ from VITE_PLATFORM_DOMAIN.
VITE_STOREFRONT_BASE_URL=http://localhost:4321
# The tenant the dev storefront serves (mirrors theme-agency's
# LOCALHOST_TENANT_SLUG). Dev-only: shows a warning when it is not this agency.
VITE_STOREFRONT_TENANT_SLUG=demo
