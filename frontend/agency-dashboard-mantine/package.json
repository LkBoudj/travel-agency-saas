{
  "name": "mantine-vite-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "oxlint -c oxlint.config.mjs .",
    "stylelint": "stylelint '**/*.css' --cache",
    "format:test": "oxfmt -c oxfmt.config.mjs --check \"**/*.{ts,tsx}\"",
    "format:write": "oxfmt -c oxfmt.config.mjs --write \"**/*.{ts,tsx}\"",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "npm run typecheck && npm run format:test && npm run lint && npm run vitest && npm run build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/dates": "^9.6.2",
    "@mantine/form": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/modals": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^30.0.0",
    "oxc-config-mantine": "^1.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.70.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "storybook": "^10.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
