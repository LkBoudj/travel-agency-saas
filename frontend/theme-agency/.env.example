# Origin of the backend NestJS API (Storefront read boundary).
# When set, public + lab pages render real tenant data.
# When absent, the render path falls back to demo fixtures.
WEBSITE_API_URL=http://localhost:3000

# Dev-only: tenant slug to resolve when hitting localhost / 127.0.0.1
# Must match the agency's lowercased code / AgencyWebsite.slug.
LOCALHOST_TENANT_SLUG=agy-0c937b377b89

# Secret shared with the backend for verifying Theme Lab preview tokens.
# Must match the backend's PREVIEW_TOKEN_SECRET.
PREVIEW_TOKEN_SECRET=theme-test-secret
