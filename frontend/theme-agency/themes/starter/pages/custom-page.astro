---
import type { RenderContext, ThemeSettings } from "@theme-agency/sdk";
import Footer from "../components/Footer.astro";

interface Props {
  context: RenderContext;
  settings: ThemeSettings;
}

const { context } = Astro.props as Props;
if (context.page.kind !== "custom-page") {
  throw new Error(`[starter] custom-page template received ${context.page.kind} page model`);
}

const { title, content } = context.page.content;
---

<div class="custom-page-container">
  <header class="custom-page-header">
    <h1 class="custom-page-title">{title}</h1>
  </header>
  <div class="custom-page-body" set:html={content} />
</div>
<Footer context={context} />

<style>
  .custom-page-container {
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 3.5rem 5rem;
  }
  .custom-page-header {
    margin-block-end: 2rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--semantic-border);
  }
  .custom-page-title {
    font-family: var(--primitive-font-family-serif);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--semantic-text);
    margin: 0;
    line-height: 1.25;
  }
  .custom-page-body {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--semantic-text);
    white-space: pre-wrap;
  }
  .custom-page-body p {
    margin-block-end: 1.25rem;
  }
</style>
