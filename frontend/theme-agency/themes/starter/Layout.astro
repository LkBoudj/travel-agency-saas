---
import type { RenderContext, ThemeSettings } from "@theme-agency/sdk";
import Header from "./components/Header.astro";
import { buildStarterTokenCss } from "./tokens";

interface Props {
  context: RenderContext;
  settings: ThemeSettings;
}

const { context } = Astro.props as Props;
const { css: tokenCss } = buildStarterTokenCss(context.branding);
void tokenCss;
---

<!doctype html>
<html lang={context.locale} dir={context.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Platform-owned SEO tags; themes must keep this slot. -->
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={tokenCss}></style>
  </head>
  <body class={`theme-${context.themeId} page-${context.page.kind}`}>
    <a class="theme-skip-link" href="#main">Skip to content</a>
    <Header context={context} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  body {
    margin: 0;
    font-family: var(--primitive-font-family-sans);
    color: var(--semantic-text);
    background: var(--semantic-surface);
    overflow-x: hidden;
  }

  body:not(.page-home) #main {
    padding-block-start: var(--site-header-height);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--primitive-font-family-sans);
    letter-spacing: -0.02em;
    font-weight: var(--primitive-font-weight-bold);
  }

  ::selection {
    background: var(--semantic-brand-soft);
    color: var(--semantic-brand-strong);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease, opacity 150ms ease;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  button, input, select {
    font-family: inherit;
  }

  .theme-skip-link {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    z-index: 100;
    transform: translateY(-150%);
    background: var(--semantic-brand);
    color: var(--semantic-brand-fg);
    padding: 0.5rem 0.75rem;
    border-radius: var(--primitive-radius-sm);
    font-size: var(--primitive-font-size-sm);
    font-weight: var(--primitive-font-weight-semibold);
  }

  .theme-skip-link:focus {
    transform: none;
  }

  /* Shared Button Utilities */
  .theme-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 3.5rem;
    padding-inline: 2rem;
    border-radius: var(--primitive-radius-full);
    background: var(--semantic-brand);
    color: var(--semantic-brand-fg);
    font-size: var(--primitive-font-size-md);
    font-weight: var(--primitive-font-weight-semibold);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px -2px rgba(15, 118, 110, 0.35);
    transition: transform 250ms ease, box-shadow 250ms ease, filter 200ms ease;
  }

  .theme-btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 6px 20px -2px rgba(15, 118, 110, 0.45);
  }

  .theme-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    height: 3.5rem;
    padding-inline: 2rem;
    border-radius: var(--primitive-radius-full);
    background: transparent;
    color: var(--primitive-color-white);
    border: 1px solid rgba(255, 255, 255, 0.45);
    font-size: var(--primitive-font-size-md);
    font-weight: var(--primitive-font-weight-semibold);
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .theme-btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.1);
  }
</style>