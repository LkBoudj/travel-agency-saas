---
import type { RenderContext, ThemeSettings } from "@theme-agency/sdk";
import { booleanSetting } from "@theme-agency/sdk";
import Icon from "./Icon.astro";
import Section from "./Section.astro";

interface Props {
  context: RenderContext;
  settings: ThemeSettings;
}

const { context, settings } = Astro.props as Props;
const testimonials = context.page.kind === "home" ? context.page.content.testimonials : [];
const show = booleanSetting(settings, "homepage.showTestimonials", true);
---

{
  show && testimonials.length > 0 && (
    <Section
      id="testimonials"
      eyebrow="Traveler stories"
      title="What our travelers say"
      headingId="testimonials-heading"
    >
      <ul class="theme-testimonial-grid">
        {
          testimonials.map((item) => (
            <li class="theme-testimonial-card">
              <Icon name="star" size={18} />
              <blockquote class="theme-testimonial-quote">{item.quote}</blockquote>
              <footer class="theme-testimonial-author">
                <strong>{item.author}</strong>
                {item.role && <span>{item.role}</span>}
              </footer>
            </li>
          ))
        }
      </ul>
    </Section>
  )
}

<style is:global>
  .theme-testimonial-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .theme-testimonial-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--component-card-bg);
    border: 1px solid var(--component-card-border);
    border-radius: var(--primitive-radius-lg);
  }

  .theme-testimonial-card > .theme-icon {
    color: var(--semantic-accent);
  }

  .theme-testimonial-quote {
    margin: 0;
    color: var(--semantic-text);
    font-size: var(--primitive-font-size-md);
    line-height: 1.5;
  }

  .theme-testimonial-author {
    display: grid;
    gap: 0.15rem;
  }

  .theme-testimonial-author strong {
    color: var(--semantic-text);
    font-weight: var(--primitive-font-weight-semibold);
    font-size: var(--primitive-font-size-sm);
  }

  .theme-testimonial-author span {
    color: var(--semantic-text-muted);
    font-size: var(--primitive-font-size-sm);
  }

  @media (min-width: 48rem) {
    .theme-testimonial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>