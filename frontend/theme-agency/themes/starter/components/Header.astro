---
import type { RenderContext } from "@theme-agency/sdk";

interface Props {
  context: RenderContext;
}

const { context } = Astro.props as Props;
const nav = context.navigation;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-header-brand" href={context.paths.home} aria-label={context.branding.name}>
      {context.branding.logo ? (
        <img src={context.branding.logo} alt={context.branding.name} class="site-header-logo" />
      ) : (
        <span class="site-header-wordmark">{context.branding.name}</span>
      )}
    </a>
    {
      nav.length > 0 && (
        <nav class="site-header-nav" aria-label="Primary">
          <ul class="site-header-list">
            {
              nav.map((link) => (
                <li>
                  <a href={link.href} class="site-header-link">{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style is:global>
  :root {
    --site-header-height: 4rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--component-header-bg);
    border-block-end: 1px solid var(--component-header-border);
  }

  .site-header-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
    height: var(--site-header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--primitive-font-weight-semibold);
    letter-spacing: 0.01em;
    color: var(--component-header-link);
    text-decoration: none;
    font-size: var(--primitive-font-size-lg);
  }

  .site-header-logo {
    max-height: 2.25rem;
    width: auto;
    height: auto;
  }

  .site-header-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .site-header-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-header-link {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--primitive-radius-sm);
    color: var(--component-header-link);
    text-decoration: none;
    font-size: var(--primitive-font-size-sm);
    font-weight: var(--primitive-font-weight-medium);
  }

  .site-header-link:hover {
    background: var(--semantic-surface-muted);
  }

  @media (min-width: 40rem) {
    .site-header-link {
      padding-inline: 1rem;
    }
  }
</style>