---
import type { TourSummary } from "@theme-agency/sdk";
import Icon from "./Icon.astro";

interface Props {
  tour: TourSummary;
  detailHref: string;
}

const { tour, detailHref } = Astro.props as Props;
const destination = tour.destinations && tour.destinations.length > 0 ? tour.destinations[0] : null;

// Determine badge based on slug or characteristics for approved visual fidelity
let badgeType: "best-seller" | "featured" | "limited" | null = null;
if (tour.slug.includes("santorini") || tour.slug.includes("escape")) {
  badgeType = "best-seller";
} else if (tour.slug.includes("istanbul") || tour.slug.includes("discovery")) {
  badgeType = "featured";
} else if (tour.slug.includes("dubai") || tour.slug.includes("adventure")) {
  badgeType = "limited";
}

function formatPrice(amount: number, currency: string): string {
  try {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: currency || "USD",
      maximumFractionDigits: 0,
    }).format(amount);
  } catch {
    return `${currency || "$"} ${amount.toLocaleString()}`;
  }
}
---

<article class="theme-tour-card">
  <div class="theme-tour-card-media-wrapper">
    <a href={detailHref} class="theme-tour-card-image-link" aria-label={`${tour.title} — view details`}>
      {
        tour.image ? (
          <img
            src={tour.image.src}
            alt={tour.image.alt || tour.title}
            class="theme-tour-card-image"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="theme-tour-card-image-fallback">
            <Icon name={tour.icon ?? "compass"} size={40} />
          </div>
        )
      }
      <span class="theme-tour-card-image-overlay" aria-hidden="true"></span>
    </a>

    <!-- Top Badge -->
    {
      badgeType === "best-seller" ? (
        <span class="theme-tour-badge theme-tour-badge--best-seller">
          <Icon name="crown" size={14} strokeWidth={2} />
          <span>Best Seller</span>
        </span>
      ) : badgeType === "featured" ? (
        <span class="theme-tour-badge theme-tour-badge--featured">
          <Icon name="star" size={14} strokeWidth={2} fill="currentColor" />
          <span>Featured</span>
        </span>
      ) : badgeType === "limited" ? (
        <span class="theme-tour-badge theme-tour-badge--limited">
          <Icon name="flame" size={14} strokeWidth={2} />
          <span>Limited Availability</span>
        </span>
      ) : (
        <span class="theme-tour-badge theme-tour-badge--default">
          <Icon name="clock" size={14} strokeWidth={2} />
          <span>{tour.durationDays} {tour.durationDays === 1 ? "Day" : "Days"}</span>
        </span>
      )
    }

    <!-- Favorite Button -->
    <button
      type="button"
      class="theme-tour-favorite-btn"
      aria-label={`Save ${tour.title} to favorites`}
    >
      <Icon name="heart" size={18} strokeWidth={2} />
    </button>
  </div>

  <div class="theme-tour-card-body">
    <div class="theme-tour-card-main">
      <h3 class="theme-tour-card-title">
        <a href={detailHref} class="theme-tour-title-link">
          {tour.title}
        </a>
      </h3>

      {
        destination && (
          <p class="theme-tour-card-dest">
            <span class="theme-tour-dest-icon">
              <Icon name="map-pin" size={16} strokeWidth={2} />
            </span>
            <span>{destination}</span>
          </p>
        )
      }

      <div class="theme-tour-card-meta">
        <span class="theme-tour-meta-item">
          <Icon name="calendar" size={16} strokeWidth={2} />
          <span>{tour.durationDays} {tour.durationDays === 1 ? "Day" : "Days"}</span>
        </span>

        <span class="theme-tour-meta-item theme-tour-rating">
          <Icon name="star" size={16} strokeWidth={2} fill="currentColor" />
          <span class="theme-tour-rating-val">4.9</span>
          <span class="theme-tour-review-count">(240)</span>
        </span>
      </div>
    </div>

    <div class="theme-tour-card-footer">
      <div class="theme-tour-price-box">
        <span class="theme-tour-price-label">From</span>
        {
          tour.price ? (
            <p class="theme-tour-price-amount">
              {formatPrice(tour.price.amount, tour.price.currency)}
              <span class="theme-tour-price-unit">/ person</span>
            </p>
          ) : (
            <p class="theme-tour-price-request">Price on request</p>
          )
        }
      </div>

      <a href={detailHref} class="theme-tour-view-btn">
        <span>View Tour</span>
        <Icon name="arrow" size={15} strokeWidth={2} />
      </a>
    </div>
  </div>
</article>

<style is:global>
  .theme-tour-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--primitive-color-white);
    border: 1px solid var(--semantic-border);
    border-radius: 1.25rem; /* 20px */
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition: transform 300ms ease, box-shadow 300ms ease, border-color 200ms ease;
  }

  .theme-tour-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -20px rgba(15, 23, 42, 0.18);
    border-color: var(--primitive-color-neutral-300);
  }

  .theme-tour-card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--semantic-surface-muted);
  }

  .theme-tour-card-image-link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .theme-tour-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    transition: transform 700ms ease-out;
  }

  .theme-tour-card:hover .theme-tour-card-image {
    transform: scale(1.035);
  }

  .theme-tour-card-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--semantic-surface-alt);
    color: var(--semantic-brand);
  }

  .theme-tour-card-image-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.15), transparent 40%);
  }

  /* Badges */
  .theme-tour-badge {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--primitive-radius-full);
    font-size: 0.75rem; /* 12px */
    font-weight: var(--primitive-font-weight-semibold);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .theme-tour-badge--best-seller {
    background: var(--primitive-color-brand-soft);
    color: var(--semantic-brand);
  }

  .theme-tour-badge--featured {
    background: var(--primitive-color-badge-sky-bg);
    color: var(--primitive-color-badge-sky-fg);
  }

  .theme-tour-badge--limited {
    background: var(--primitive-color-badge-amber-bg);
    color: var(--primitive-color-badge-amber-fg);
  }

  .theme-tour-badge--default {
    background: rgba(255, 255, 255, 0.92);
    color: var(--semantic-text);
  }

  /* Favorite Button */
  .theme-tour-favorite-btn {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--primitive-radius-full);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--semantic-text-muted);
    border: none;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
    cursor: pointer;
    transition: color 200ms ease, transform 200ms ease;
  }

  .theme-tour-favorite-btn:hover {
    color: var(--semantic-brand);
    transform: scale(1.08);
  }

  /* Card Body */
  .theme-tour-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .theme-tour-card-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .theme-tour-card-title {
    margin: 0;
    font-size: 1.3125rem; /* 21px */
    font-weight: var(--primitive-font-weight-bold);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--semantic-text);
  }

  .theme-tour-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .theme-tour-title-link:hover {
    color: var(--semantic-brand);
  }

  .theme-tour-card-dest {
    margin: 0.625rem 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem; /* 15px */
    color: var(--semantic-text-muted);
  }

  .theme-tour-dest-icon {
    color: var(--semantic-brand);
    display: inline-flex;
  }

  .theme-tour-card-meta {
    margin-block-start: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem; /* 14px */
    font-weight: var(--primitive-font-weight-medium);
    color: var(--semantic-text-muted);
  }

  .theme-tour-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .theme-tour-meta-item .theme-icon {
    color: var(--semantic-brand);
  }

  .theme-tour-rating .theme-icon {
    color: var(--primitive-color-accent-500);
  }

  .theme-tour-rating-val {
    color: var(--semantic-text);
    font-weight: var(--primitive-font-weight-semibold);
  }

  .theme-tour-review-count {
    color: var(--primitive-color-neutral-400);
  }

  /* Card Footer */
  .theme-tour-card-footer {
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--semantic-border-subtle);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .theme-tour-price-box {
    display: flex;
    flex-direction: column;
  }

  .theme-tour-price-label {
    font-size: 0.75rem; /* 12px */
    font-weight: var(--primitive-font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--primitive-color-neutral-400);
  }

  .theme-tour-price-amount {
    margin: 0.25rem 0 0 0;
    font-size: 1.6875rem; /* 27px */
    font-weight: var(--primitive-font-weight-bold);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--semantic-brand);
    display: flex;
    align-items: baseline;
  }

  .theme-tour-price-unit {
    margin-inline-start: 0.375rem;
    font-size: 0.84375rem; /* 13.5px */
    font-weight: var(--primitive-font-weight-normal);
    color: var(--semantic-text-muted);
  }

  .theme-tour-price-request {
    margin: 0.25rem 0 0 0;
    font-size: 0.9375rem;
    font-weight: var(--primitive-font-weight-semibold);
    color: var(--semantic-text-muted);
  }

  .theme-tour-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem; /* 44px */
    padding-inline: 1.5rem;
    border-radius: var(--primitive-radius-full);
    border: 1px solid var(--semantic-brand);
    background: transparent;
    color: var(--semantic-brand);
    font-size: 0.9375rem; /* 15px */
    font-weight: var(--primitive-font-weight-semibold);
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, transform 150ms ease;
  }

  .theme-tour-view-btn:hover {
    background: var(--semantic-brand);
    color: var(--primitive-color-white);
    transform: translateY(-1px);
  }

  .theme-tour-view-btn .theme-icon {
    transition: transform 200ms ease;
  }

  .theme-tour-view-btn:hover .theme-icon {
    transform: translateX(3px);
  }

  [dir="rtl"] .theme-tour-view-btn:hover .theme-icon {
    transform: translateX(-3px);
  }
</style>