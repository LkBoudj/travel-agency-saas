generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique @db.VarChar(24)
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  // Account lifecycle status. A database CHECK constraint
  // (`app_user_status_check`) restricts the value to ACTIVE | SUSPENDED.
  // ACTIVE allows authentication; SUSPENDED denies it. This is an AppUser
  // identity status (Platform + future Agency contexts), not authorization state.
  status       String   @default("ACTIVE") @map("status") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  platformRoleAssignments  PlatformRoleAssignment[]
  agencyApplications       AgencyApplication[]
  agencyApplicationReviews AgencyApplication[]      @relation("AgencyApplicationReviews")
  agencyMemberships        AgencyMembership[]

  @@map("app_user")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  // Stable, human-meaningful technical identifier (uppercase snake case). Set on
  // creation and immutable afterwards. Uniqueness is enforced by the partial
  // unique indexes below (not expressible in Prisma PSL), mirroring `name`:
  //   role_global_key_key  UNIQUE (scope, key) WHERE agency_id IS NULL
  //   role_agency_key_key  UNIQUE (agency_id, key) WHERE agency_id IS NOT NULL
  key         String   @db.VarChar(64)
  // Stable PROTECTED system identity. Null for every normal/custom role; a
  // value marks a canonical role the platform itself depends on. It is not an
  // authorization mechanism (authorization stays on `permission.key`) — it is
  // the immutable handle domain invariants are allowed to reason about, because
  // `key` and `name` are editable business metadata.
  //
  // Database guarantees (see the `agency_ownership_foundation` migration):
  //   role_system_key_key  UNIQUE (system_key) WHERE system_key IS NOT NULL
  //   role_system_key_shape_check  a non-null system_key must be a known system
  //     identity AND satisfy that identity's required shape
  //     (`AGENCY_ADMIN` => scope = 'AGENCY' AND agency_id IS NULL)
  //   role_protect_system_identity  trigger: a non-null system_key can never be
  //     changed or cleared, and such a role can never be deleted
  systemKey   String?  @map("system_key") @db.VarChar(64)
  scope       String   @db.VarChar(16)
  // Ownership discriminator for AGENCY roles. Null means the role is global
  // (PLATFORM roles, or Platform-Admin-managed global AGENCY roles); a value
  // means the role is a custom AGENCY role owned by that agency. A DB CHECK
  // (`role_agency_scope_check`) forbids a non-null agency_id on PLATFORM roles.
  agencyId    BigInt?  @map("agency_id")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions           RolePermission[]
  platformAssignments   PlatformRoleAssignment[]
  agencyRoleAssignments AgencyRoleAssignment[]

  // Name uniqueness is enforced by two partial unique indexes created in the
  // `role_agency_ownership` migration (not expressible in Prisma PSL):
  //   role_global_name_key  UNIQUE (scope, name) WHERE agency_id IS NULL
  //   role_agency_name_key  UNIQUE (agency_id, name) WHERE agency_id IS NOT NULL
  // The former `@@unique([scope, name])` was dropped because it also constrained
  // custom roles, forbidding the same role name in two different agencies.
  @@index([agencyId])
  @@map("role")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  scope       String   @db.VarChar(16)
  resource    String   @db.VarChar(64)
  action      String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  roles RolePermission[]

  @@index([scope])
  @@map("permission")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model PlatformRoleAssignment {
  id        BigInt   @id @default(autoincrement())
  roleId    BigInt   @map("role_id")
  appUserId BigInt   @map("app_user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([appUserId, roleId])
  @@index([roleId])
  @@map("platform_role_assignment")
}

model Agency {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(24)
  name        String   @db.VarChar(200)
  // Agency lifecycle status owned by the platform. The database CHECK
  // constraint (`agency_status_check`) restricts the value to ACTIVE | SUSPENDED.
  // SUSPENDED is a platform-side operation state, not an identity status.
  status      String   @default("ACTIVE") @map("status") @db.VarChar(16)
  // Optional descriptive fields captured with the agency. `country` is free
  // text for now and may later reference a Country entity.
  //
  // There is deliberately no `website`/`domain` field: custom domains are a
  // separate concern that belongs to the future Agency Dashboard -> Settings ->
  // Domain feature (configuration + DNS verification), not to this foundation.
  country     String?  @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  members      AgencyMembership[]
  applications AgencyApplication[]

  @@map("agency")
}

model AgencyApplication {
  id                  BigInt    @id @default(autoincrement())
  // Applicant identity is owned by the backend (JWT); it is never accepted
  // from a request body.
  appUserId           BigInt    @map("app_user_id")
  agencyName          String    @map("agency_name") @db.VarChar(200)
  country             String?   @db.VarChar(100)
  website             String?   @db.VarChar(255)
  description         String?   @db.Text
  // Application lifecycle. The database CHECK constraint
  // (`agency_application_status_check`) restricts the value to
  // PENDING | NEEDS_INFO | APPROVED | REJECTED | WITHDRAWN. An application is a
  // permanent audit record: it is never converted into an Agency and never
  // deleted; approval only links it to the created agency.
  status              String    @default("PENDING") @map("status") @db.VarChar(16)
  // Free-form platform review note (needs-info request, rejection reason).
  reviewNote          String?   @map("review_note") @db.Text
  // Review metadata, set by the platform action that changes the status.
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewedByAppUserId BigInt?   @map("reviewed_by_app_user_id")
  // Set on approval: the agency created from this application. One application
  // can produce at most one agency (enforced by the partial unique index
  // `agency_application_created_agency_id_key` WHERE agency_id IS NOT NULL,
  // not expressible in Prisma PSL).
  agencyId            BigInt?   @map("agency_id")
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  appUser    AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  reviewedBy AppUser? @relation("AgencyApplicationReviews", fields: [reviewedByAppUserId], references: [id])
  agency     Agency?  @relation(fields: [agencyId], references: [id])

  @@index([appUserId])
  @@index([status])
  @@index([agencyId])
  @@map("agency_application")
}

model AgencyMembership {
  id             BigInt @id @default(autoincrement())
  agencyId       BigInt @map("agency_id")
  appUserId      BigInt @map("app_user_id")
  // Ownership of the agency, kept explicit and separate from authorization.
  // A database CHECK (`agency_membership_type_check`) restricts the value to
  // OWNER | EMPLOYEE. Ownership is NEVER inferred from a role key, and holding
  // the canonical AGENCY_ADMIN role does NOT make a member the owner: an
  // EMPLOYEE may hold AGENCY_ADMIN too.
  //
  // Database guarantees (see the `agency_ownership_foundation` migration):
  //   agency_membership_owner_key  UNIQUE (agency_id) WHERE type = 'OWNER'
  //     — at most one OWNER (immediate; a partial unique index is never
  //       deferrable)
  //   agency_membership_owner_active_check  an OWNER row must be ACTIVE
  //   agency_ownership_invariants  DEFERRED constraint trigger — after COMMIT
  //     every agency has exactly one OWNER, that OWNER is ACTIVE, and that
  //     OWNER holds the canonical AGENCY_ADMIN system role
  membershipType String @map("membership_type") @db.VarChar(16)
  // Membership lifecycle. The database CHECK constraint
  // (`agency_membership_status_check`) restricts the value to ACTIVE | SUSPENDED.
  // It is a membership status inside one agency, not the AppUser identity
  // status (`app_user.status`), which stays authoritative for authentication,
  // and not the agency's own business status (`agency.status`). Suspending the
  // business is `agency.status`; an OWNER membership can never be SUSPENDED.
  status         String @default("ACTIVE") @map("status") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  agency                Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  appUser               AppUser                @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  agencyRoleAssignments AgencyRoleAssignment[]

  @@unique([agencyId, appUserId])
  @@index([appUserId])
  // Supports the ownership lookups the invariant trigger and the agency list
  // perform. "At most one OWNER" itself is the partial unique index
  // `agency_membership_owner_key`, which Prisma PSL cannot express.
  @@index([agencyId, membershipType], map: "agency_membership_type_idx")
  @@map("agency_membership")
}

model AgencyRoleAssignment {
  id           BigInt @id @default(autoincrement())
  membershipId BigInt @map("membership_id")
  roleId       BigInt @map("role_id")

  // Tenant isolation (see the `agency_role_assignment_scope` migration). Two
  // BEFORE triggers keep an assignment inside one tenant, because the rule spans
  // three tables and a CHECK cannot read other tables:
  //   agency_role_assignment_scope  the role must be scope = AGENCY, and either
  //     global (agency_id IS NULL) or owned by the membership's own agency
  //   role_protect_assigned_scope   a role's scope/owning agency cannot change
  //     while it is assigned, so a valid assignment cannot later become a
  //     cross-tenant grant
  // AgencyPermissionsService applies the same rule again when computing
  // permissions, so a row that somehow bypassed the database grants nothing.

  membership AgencyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("agency_role_assignment")
}

/**
 * Security-relevant events, append-only.
 *
 * It exists so questions like "has the directory been probed?" or "who removed
 * that member?" have an answer. Rows are never updated or deleted by
 * application code.
 *
 * Deliberately NOT a foreign key to AppUser or Agency: an audit record must
 * survive the deletion of whatever it describes, and a cascade would erase
 * exactly the history an investigation needs. Actors and agencies are recorded
 * by their stable public `code`.
 *
 * `targetHash` carries a SHA-256 of a sensitive lookup term (for example a
 * searched email) so repeated probing is still correlatable without the log
 * itself becoming a second copy of the data being protected.
 */
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  /** Stable event name, e.g. PLATFORM_APP_USER_SEARCH, AGENCY_MEMBER_REMOVE. */
  action    String   @db.VarChar(64)
  /** SUCCESS | DENIED | FAILURE. */
  outcome   String   @db.VarChar(16)
  /** The acting AppUser's public code; null for an unauthenticated attempt. */
  actorCode String?  @map("actor_code") @db.VarChar(24)
  /** The agency the action happened in, when it was agency-scoped. */
  agencyCode String? @map("agency_code") @db.VarChar(24)
  /** The subject's public code, when the action names one. */
  targetCode String? @map("target_code") @db.VarChar(24)
  /** SHA-256 of a sensitive term, never the term itself. */
  targetHash String? @map("target_hash") @db.VarChar(64)
  /** Small non-sensitive context (result counts, error codes). */
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([action, createdAt])
  @@index([actorCode, createdAt])
  @@index([agencyCode, createdAt])
  @@map("audit_log")
}
