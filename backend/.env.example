# Runtime environment validated by the NestJS app (NODE_ENV, PORT, DATABASE_URL).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# Authentication. JWT_SECRET is required (>= 32 chars) — generate one with:
#   openssl rand -base64 48
# Never commit the real value. Short-lived access token lifetime for the JWT
# `expiresIn` and the auth cookie Max-Age (s|m|h|d).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# JWT_EXPIRES_IN=15m

# Prisma CLI tooling only (Neon direct/unpooled connection, not validated at runtime).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require

# CORS allowlist (comma-separated browser origins). When unset in development,
# the dev origins are allowed by default: http://localhost:5173 (dashboard)
# and http://localhost:5174 (admin), plus their 127.0.0.1 equivalents.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed-only. When set and a matching app_user already exists, `prisma db seed`
# assigns the PLATFORM_ADMIN role to that user. No personal email is hardcoded.
# RBAC_BOOTSTRAP_EMAIL=owner@agency.example

# Member invitations. Expiry window for new invitations.
# MEMBER_INVITE_EXPIRES_HOURS=72
# Delivery channel for the invitation link: `none` (persist but do not send) or
# `dev` (log the accept link; refused in NODE_ENV=production).
# MEMBER_INVITE_DELIVERY=none
